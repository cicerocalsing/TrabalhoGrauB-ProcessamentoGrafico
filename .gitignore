# Cache criado pelo download do Hugging Face (as fotos e anotações vão para o git)
dados/**/.cache/

# Ambiente virtual e cache do Python
.venv/
__pycache__/
*.pyc

# Arquivos do sistema/editor
.vscode/
.idea/
Thumbs.db
desktop.ini

# Imagens de resultados: só as configurações C2 e C3 (conectividade 4 e 8)
# Os CSVs de todas as configurações continuam no repositório
resultados/*/imagens/
!resultados/*_C2_*/imagens/
!resultados/*_C3_*/imagens/
